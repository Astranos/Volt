# Copy to .env (gitignored) before running any lane that builds or uploads.
# fastlane loads fastlane/.env automatically — no --env flag needed.

# Clerk production credentials. The beta/archive lanes refuse to build without
# these: the publishable key must be the pk_live_ one, and the domain is the
# Clerk Frontend API host, bare (no scheme). Both already exist in
# packages/extension/.env.local as WXT_CLERK_PUBLISHABLE_KEY and as the host
# encoded inside it.
VOLT_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
VOLT_CLERK_FRONTEND_API_DOMAIN=clerk.example.com

# App Store Connect API key, used for both the fastlane upload and xcodebuild's
# -authenticationKeyPath. The path must be absolute — xcodebuild rejects a
# relative one. The issuer ID defaults correctly in the Fastfile.
APP_STORE_CONNECT_API_KEY_ID=REPLACE_ME
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_REPLACE_ME.p8
