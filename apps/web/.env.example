# Copy to apps/web/.env.local and fill in. Only VITE_-prefixed variables reach
# the browser bundle; this app has no server runtime, so no Clerk secret key is
# needed here.

# Clerk publishable key for the instance that backs VITE_CONVEX_URL below.
# Use a pk_test_ key with the dev Convex deployment, pk_live_ with production.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Convex deployment the browser client connects to (the .convex.cloud host, not
# the .convex.site HTTP-actions host). Set this explicitly in Vercel for both
# Production and Preview — a preview build is also a production-mode Vite build,
# so import.meta.env.PROD cannot tell them apart.
#   dev:  https://adorable-hornet-19.convex.cloud
#   prod: https://sincere-trout-414.convex.cloud
VITE_CONVEX_URL=https://adorable-hornet-19.convex.cloud
