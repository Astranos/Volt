{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @volt/web build:static",
  "devCommand": "pnpm --filter @volt/web dev",
  "installCommand": "pnpm install --ignore-scripts",
  "outputDirectory": "apps/web/dist",
  "headers": [
    {
      "source": "/upc-search/:path*",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/upc-search", "destination": "/upc-search.html" },
    { "source": "/upc-search/", "destination": "/upc-search.html" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/.well-known/apple-app-site-association"
    },
    {
      "source": "/apple-app-site-association",
      "destination": "/apple-app-site-association"
    },
    {
      "source": "/clip",
      "destination": "/clip.html"
    },
    {
      "source": "/clip/",
      "destination": "/clip.html"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
